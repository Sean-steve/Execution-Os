# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# HEE_SECURITY_SECRET: 32+ character cryptographic master secret key for Execution OS HMAC token signing and payload integrity.
# Required in production mode.
HEE_SECURITY_SECRET="hee_production_master_cryptographic_secret_key_32_bytes"

# HEE_DATABASE_PATH: File path for the durable canonical JSON database engine.
# Defaults to ./data/canonical_execution_db.json
HEE_DATABASE_PATH="./data/canonical_execution_db.json"

# NODE_ENV: Runtime environment (development | production | test)
NODE_ENV="development"

# Production-only bootstrap credential used to authorize session-token issuance.
# Required in NODE_ENV=production and must be at least 32 characters.
HEE_AUTH_BOOTSTRAP_SECRET=


# HumanKernelOS integration identity/event trust secret (32+ characters). Required in production HOS mode.
HOS_EXECUTION_SHARED_SECRET=

# HTTPS endpoint for the HumanKernelOS Event Mesh. Required in production HOS mode.
HOS_EVENT_MESH_URL=
HOS_EVENT_MESH_TIMEOUT_MS=5000

# Durable HOS boundary, per-subject state, and dead-letter storage.
HOS_BOUNDARY_STORE_PATH="./data/hos_boundary_store.json"
EXECUTION_OS_SUBJECT_DATA_DIR="./data/subjects"
HEE_DLQ_PATH="./data/dead_letter_queue.json"

# HOS API protection and payload bounds.
HOS_RATE_LIMIT_WINDOW_MS=60000
HOS_RATE_LIMIT_MAX_REQUESTS=120
EXECUTION_OS_MAX_JSON_BODY="1mb"


# E10 — Live backend persistence. Use "postgres" for durable multi-device/HOS runtime state.
EXECUTION_OS_PERSISTENCE="file"
EXECUTION_OS_REQUIRE_POSTGRES="false"
DATABASE_URL=
DATABASE_SSL="disable"
DATABASE_SSL_REJECT_UNAUTHORIZED="true"
DATABASE_CA_CERT=
EXECUTION_OS_PG_POOL_MAX=10
EXECUTION_OS_PG_IDLE_TIMEOUT_MS=30000
EXECUTION_OS_PG_CONNECTION_TIMEOUT_MS=5000

# Subject-aware always-on HOS worker runtime.
EXECUTION_OS_WORKER_TICK_MS=30000
EXECUTION_OS_TIMEZONE="Africa/Nairobi"
